# ---- Backend (agent container) ----
PORT=3000
LOG_LEVEL=info

# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Speech-to-text (tab-audio capture, optional). Uses OpenAI Whisper.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
STT_LANGUAGE=en

# Supabase (Postgres + Auth). Use the SERVICE ROLE key server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL the in-page script posts transcripts/audio back to (usually the container's public URL)
BACKEND_BASE_URL=https://agent.yourdomain.com

# Owner user id for scheduled auto-joins (a Supabase auth.users id)
SCHEDULER_USER_ID=

# Sentry error tracking (optional — leave blank to disable)
SENTRY_DSN=https://key@o0.ingest.us.sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
