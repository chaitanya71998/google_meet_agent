# Vercel frontend environment variables
# These are exposed to the browser (NEXT_PUBLIC_*). Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the agent backend (your container/VM), e.g. https://agent.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=https://agent.yourdomain.com
# Sentry DSN for frontend error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=https://key@o0.ingest.us.sentry.io/project-id
